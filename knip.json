{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["scripts/**/*.mjs", "vitest.workspace.ts"],
  "project": ["**/*.ts", "**/*.tsx", "**/*.mjs"],
  "ignore": [
    "**/build/**",
    "**/coverage/**",
    "**/dist/**",
    "**/.husky/**",
    "apps/desktop/src-tauri/sidecar/server.bundle.mjs",
    "apps/desktop/src-tauri/target/**",
    "docs/.docusaurus/**"
  ],
  "include": ["dependencies", "devDependencies", "unlisted", "binaries", "unresolved"],
  "ignoreDependencies": [
    "@types/node",
    "typescript",
    "vitest",
    "@vitest/coverage-v8",
    "esbuild",
    "tsx",
    "@react-native/babel-preset",
    "@react-native-community/cli",
    "@react-native-community/cli-platform-android",
    "@react-native-community/cli-platform-ios",
    "@react-native/gradle-plugin",
    "@react-native/community-cli-plugin",
    "@napi-rs/cli",
    "@babel/runtime",
    "@ghita/ai-engine",
    "@ghita/browser-control",
    "@ghita/code-graph",
    "@ghita/communication",
    "@ghita/computer-use",
    "@ghita/memory",
    "@ghita/security",
    "@ghita/shared",
    "socket.io",
    "@react-native/codegen",
    "lint-staged"
  ],
  "ignoreBinaries": ["stryker", "cargo", "taskkill", "pod", "lint-staged"],
  "rules": {
    "files": "off",
    "devDependencies": "warn",
    "duplicates": "warn",
    "nsExports": "off",
    "nsTypes": "off",
    "unlisted": "warn"
  }
}
