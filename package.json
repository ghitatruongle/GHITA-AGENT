{
  "name": "ghita-coding-agent",
  "version": "1.2.0-demo1",
  "private": true,
  "type": "module",
  "description": "GHITA CODING AGENT - Desktop AI Agent với multi-provider, skills, computer use",
  "author": "ghitatruongle",
  "license": "MIT",
  "scripts": {
    "dev": "turbo dev",
    "dev:desktop": "node -e \"const{execSync}=require('child_process');try{execSync('pnpm --filter @ghita/desktop tauri dev',{stdio:'inherit', timeout: 600000})}catch(e){process.exit(e.status||1)}\"",
    "dev:android": "pnpm --filter @ghita/mobile android",
    "bootstrap": "node scripts/fix-store.mjs && pnpm install --frozen-lockfile",
    "doctor": "node scripts/doctor.mjs",
    "setup": "node scripts/doctor.mjs && pnpm bootstrap && pnpm build:packages",
    "build": "turbo build --filter=./packages/* --filter=./apps/desktop --filter=./apps/vscode-extension && pnpm --filter @ghita/mobile build",
    "build:desktop": "node -e \"const{execSync}=require('child_process');try{execSync('pnpm --filter @ghita/desktop tauri build',{stdio:'inherit', timeout: 900000})}catch(e){process.exit(e.status||1)}\"",
    "build:installer": "node scripts/build-installer.mjs",
    "build:installer:debug": "node scripts/build-installer.mjs --debug",
    "build:android": "pnpm --filter @ghita/mobile build:release",
    "build:packages": "turbo build --filter=./packages/*",
    "build:native": "node scripts/build-native.mjs",
    "lint": "turbo lint --concurrency=2",
    "lint:fix": "turbo lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "typecheck": "turbo typecheck",
    "test": "turbo test --concurrency=2",
    "test:coverage": "turbo test --concurrency=2 -- --coverage",
    "benchmark:quality-loop": "tsx tests/quality-loop/runner.ts",
    "benchmark:compare": "tsx tests/quality-loop/compare-methods.ts",
    "clean": "turbo clean",
    "clean:all": "turbo clean && rm -rf node_modules && rm -rf packages/*/node_modules && rm -rf apps/*/node_modules",
    "rebuild": "rm -rf node_modules packages/*/node_modules apps/*/node_modules && pnpm install && turbo build --filter=./packages/* --filter=./apps/desktop --filter=./apps/vscode-extension --force && pnpm --filter @ghita/mobile build",
    "build:docs": "node --max-old-space-size=8192 node_modules/typedoc/bin/typedoc --options typedoc.json && node scripts/sanitize-typedoc-mdx.mjs",
    "docs:serve": "cd docs && pnpm start",
    "knip": "knip",
    "audit:policy": "node scripts/audit-policy.mjs",
    "licenses:check": "node scripts/check-licenses.mjs",
    "dogfood": "node scripts/dogfood.mjs",
    "integrity": "node scripts/sync-version.mjs --check && node scripts/check-artifacts.mjs",
    "coverage:tiers": "node scripts/check-coverage-tiers.mjs",
    "smells": "node scripts/count-smells.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@eslint/js": "^9.15.0",
    "@ghita/agents": "workspace:*",
    "@ghita/quotas": "workspace:*",
    "@ghita/security": "workspace:*",
    "@ghita/skills": "workspace:*",
    "@playwright/test": "^1.62.0",
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "3.2.4",
    "esbuild": "^0.28.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.9.0",
    "globals": "^15.12.0",
    "husky": "^9.1.7",
    "knip": "5.63.1",
    "lint-staged": "^15.4.3",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.4.0",
    "react": "^18.3.1",
    "screenshot-desktop": "^1.15.6",
    "sharp": "^0.34.5",
    "tsx": "^4.19.2",
    "turbo": "^2.9.16",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "8.59.4",
    "vitest": "^3.2.4",
    "zod": "^3.25.76"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{js,jsx}": [
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ],
    "*.css": [
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.5.2",
  "resolutions": {
    "ws": "^8.20.1",
    "serialize-javascript": "^7.0.5",
    "uuid": "^11.1.1",
    "cross-spawn": "^7.0.5"
  }
}
