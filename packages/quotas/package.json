{
  "name": "@ghita/quotas",
  "version": "1.2.0-demo1",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "description": "GHITA CODING AGENT - Rate Limiting & Quota Management (Phase 43)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.readdirSync('.').filter(f=>f.endsWith('.tsbuildinfo')).forEach(f=>fs.rmSync(f,{force:true}))\""
  },
  "dependencies": {
    "@ghita/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7"
  }
}
