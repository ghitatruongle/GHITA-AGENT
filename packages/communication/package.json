{
  "name": "@ghita/communication",
  "version": "1.2.0-demo1",
  "private": true,
  "sideEffects": false,
  "description": "Desktop <-> Mobile communication (Socket.io) cho GHITA CODING AGENT",
  "main": "./dist/index.js",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.readdirSync('.').filter(f=>f.endsWith('.tsbuildinfo')).forEach(f=>fs.rmSync(f,{force:true}))\"",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ghita/shared": "workspace:*",
    "screenshot-desktop": "^1.15.6",
    "socket.io": "^4.8.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
