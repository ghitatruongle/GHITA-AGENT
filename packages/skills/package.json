{
  "name": "@ghita/skills",
  "version": "1.2.0-demo1",
  "private": true,
  "sideEffects": false,
  "description": "Skill system cho GHITA CODING AGENT",
  "main": "./dist/index.js",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./marketplace/*": {
      "types": "./dist/marketplace/*.d.ts",
      "import": "./dist/marketplace/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.readdirSync('.').filter(f=>f.endsWith('.tsbuildinfo')).forEach(f=>fs.rmSync(f,{force:true}))\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ghita/agents": "workspace:*",
    "@ghita/ai-engine": "workspace:*",
    "@ghita/ingest": "workspace:*",
    "@ghita/mcp": "workspace:*",
    "@ghita/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7"
  }
}
