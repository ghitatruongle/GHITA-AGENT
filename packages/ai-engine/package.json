{
  "name": "@ghita/ai-engine",
  "version": "1.2.0-demo1",
  "private": true,
  "sideEffects": false,
  "description": "AI multi-provider engine cho GHITA CODING AGENT",
  "main": "./dist/index.js",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && node copy-proto.js",
    "dev": "tsc -b --watch",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_OPTIONS='--experimental-vm-modules' vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.readdirSync('.').filter(f=>f.endsWith('.tsbuildinfo')).forEach(f=>fs.rmSync(f,{force:true}))\"",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ghita/agents": "workspace:*",
    "@ghita/native-bridge": "workspace:*",
    "@ghita/shared": "workspace:*",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "better-sqlite3": "^12.10.0",
    "ws": "^8.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/ws": "^8.5.12",
    "cross-env": "^10.1.0",
    "typescript": "^5.6.0",
    "fast-check": "^4.9.0",
    "vitest": "^3.2.7",
    "yaml": "^2.9.0"
  }
}
