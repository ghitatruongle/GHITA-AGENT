{
  "name": "@ghita/vscode-extension",
  "version": "1.2.0-demo1",
  "private": true,
  "description": "VS Code Sidecar Extension for GHITA CODING AGENT",
  "publisher": "ghita",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ghita-sidecar.connect",
        "title": "GHITA: Connect Sidecar",
        "category": "GHITA CODING AGENT"
      },
      {
        "command": "ghita-sidecar.disconnect",
        "title": "GHITA: Disconnect Sidecar",
        "category": "GHITA CODING AGENT"
      },
      {
        "command": "ghita-sidecar.syncWorkspace",
        "title": "GHITA: Sync Workspace Files",
        "category": "GHITA CODING AGENT"
      },
      {
        "command": "ghita-sidecar.stats",
        "title": "GHITA: Show Sync Statistics",
        "category": "GHITA CODING AGENT"
      }
    ],
    "configuration": {
      "title": "GHITA CODING AGENT",
      "properties": {
        "ghita.corePort": {
          "type": "integer",
          "default": 8080,
          "description": "Port of the running GHITA sidecar server (Socket.io)."
        },
        "ghita.autoSync": {
          "type": "boolean",
          "default": true,
          "description": "Whether to auto-sync workspace files on save."
        },
        "ghita.debounceMs": {
          "type": "integer",
          "default": 300,
          "description": "Debounce interval in ms for file save sync."
        },
        "ghita.maxRetries": {
          "type": "integer",
          "default": 20,
          "description": "Maximum reconnection attempts."
        },
        "ghita.reconnectDelayMs": {
          "type": "integer",
          "default": 2000,
          "description": "Delay between reconnection attempts in ms."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "compile": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.readdirSync('.').filter(f=>f.endsWith('.tsbuildinfo')).forEach(f=>fs.rmSync(f,{force:true}))\""
  },
  "dependencies": {
    "@ghita/shared": "workspace:*",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/vscode": "^1.96.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
