{
  "name": "@ghita/mobile",
  "version": "1.2.0-demo1",
  "private": true,
  "description": "GHITA CODING AGENT — Mobile Remote Control (React Native Android, minSdk=28)",
  "scripts": {
    "android": "react-native run-android",
    "start": "react-native start",
    "dev": "react-native start",
    "build": "tsc --noEmit && react-native bundle --platform android --dev false --entry-file index.js --bundle-output dist/index.android.bundle --assets-dest dist/assets",
    "build:release": "node scripts/run-gradle.mjs assembleRelease",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "jest",
    "clean": "node -e \"['dist', 'android/app/build'].forEach(p => require('fs').rmSync(p, {recursive:true,force:true}))\"",
    "postinstall": "node scripts/patch-jcenter.js"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@ghita/shared": "workspace:*",
    "@noble/ciphers": "^2.3.0",
    "@noble/hashes": "^2.3.0",
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "react": "^18.3.1",
    "react-native": "^0.76.0",
    "react-native-bluetooth-classic": "1.73.0-rc.17",
    "react-native-keychain": "^8.2.0",
    "react-native-paper": "^5.15.3",
    "react-native-safe-area-context": "^5.4.1",
    "react-native-screens": "^3.35.0",
    "react-native-vector-icons": "^10.3.0",
    "socket.io-client": "^4.8.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@react-native-community/cli": "^15.0.1",
    "@react-native-community/cli-platform-android": "^15.1.3",
    "@react-native-community/cli-platform-ios": "^15.1.3",
    "@react-native/babel-preset": "^0.87.1",
    "@react-native/codegen": "0.87.1",
    "@react-native/community-cli-plugin": "^0.87.1",
    "@react-native/gradle-plugin": "^0.87.1",
    "@react-native/metro-babel-transformer": "0.87.1",
    "@react-native/metro-config": "^0.87.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.18",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-expo": "^52.0.5",
    "metro-config": "^0.87.0",
    "metro-minify-terser": "0.87.0",
    "metro-transform-worker": "0.87.0",
    "typescript": "^5.6.0"
  }
}
