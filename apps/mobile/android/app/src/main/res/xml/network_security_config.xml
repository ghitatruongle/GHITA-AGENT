<?xml version="1.0" encoding="utf-8"?>
<!--
  Ghita Agent — Network Security Config

  Cleartext (HTTP) is ONLY allowed for RFC1918 private LAN addresses used by the
  desktop sidecar (Socket.IO + health check on port 8080). All public traffic —
  including the cloud relay (onrender.com) — MUST use HTTPS.

  Android <domain> does not support CIDR notation. The application therefore
  permits cleartext at the platform layer and enforces RFC1918/loopback-only
  HTTP/WS destinations in services/serverAddress.ts. Public destinations must
  use HTTPS/WSS.

  TODO(Phase 5): replace cleartext entirely with a self-signed cert generated by
  the desktop sidecar and pinned via trust-anchors during pairing.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

</network-security-config>
