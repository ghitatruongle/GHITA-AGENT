# ──────────────────────────────────────────────────────────────────────────────
# Ghita Agent - MASTER .GITIGNORE
# ──────────────────────────────────────────────────────────────────────────────

# ──────────────────────────────────────────────────────────────────────────────
# 1. SECURITY, SECRETS & KEYS (CRITICAL FOR OPEN-SOURCE RELEASE)
# ──────────────────────────────────────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.env
# React Native iOS template config — tracked source, not a secret
!**/.xcode.env
*.pem
*.key
*.p12
*.pfx
*.asc
*.crt
*.cer
*.keystore
*.jks
*.mobileprovision
*.kdbx
*.tfvars
*.tfvars.json
*.htpasswd
id_rsa*
id_ed25519*
secrets.json
credentials.json

# ──────────────────────────────────────────────────────────────────────────────
# 2. MONOREPO & NODE DEPENDENCIES
# ──────────────────────────────────────────────────────────────────────────────
node_modules/
**/node_modules/
.pnp
.pnp.js
.pnp.cjs
.pnp.mjs
.pnpm-store/
**/.pnpm-store/
.turbo/
**/.turbo/

# ──────────────────────────────────────────────────────────────────────────────
# 3. BUILD OUTPUTS & COMPILATION ARTIFACTS
# ──────────────────────────────────────────────────────────────────────────────
dist/
**/dist/
build/
**/build/
out/
**/out/
target/
**/target/
.next/
*.tsbuildinfo
**/*.tsbuildinfo
*.vsix

# Docusaurus & Docs Tooling (Do NOT ignore docs/ package itself)
docs/.docusaurus/
docs/build/
docs/.cache-loader/
docs/.turbo/
docs/docs/api/
docs/superpowers/

# Compiled JS/D.TS inside TS source directories
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts.map
apps/*/src/**/*.js
apps/*/src/**/*.d.ts
apps/*/src/**/*.js.map
apps/*/src/**/*.d.ts.map
# Ambient .d.ts declarations under src are hand-written source, not build output
!packages/*/src/**/*.d.ts
!apps/*/src/**/*.d.ts

# Native C / C++ / Rust Object Files & Binaries
*.o
*.obj
*.dll
*.so
*.dylib
*.exe
*.lib
*.a
*.exp
*.pdb
*.ilk
*.node
*.rmeta
*.rlib

