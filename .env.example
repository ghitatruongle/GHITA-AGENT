# ==============================================================================
# Ghita Agent - Environment Variables
# Copy this file to .env and fill in your values
# ==============================================================================

# --- AI Provider API Keys ---

# OpenAI (GPT-4, GPT-4o, etc.)
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic (Claude 3.5 Sonnet, Claude 3 Opus, etc.)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Google (Gemini Pro, Gemini 1.5, etc.)
GOOGLE_API_KEY=your-google-api-key-here

# --- Ollama (Local AI) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Custom Provider ---
CUSTOM_API_URL=https://your-custom-api.com/v1
CUSTOM_API_KEY=your-custom-key-here

# --- Communication ---
# Port cho Socket.io server (desktop <-> mobile)
SOCKET_PORT=8080

# --- App Settings ---
# Ngôn ngữ mặc định (vi, en)
DEFAULT_LANGUAGE=vi

# Theme (dark, light, system)
DEFAULT_THEME=dark

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# ==============================================================================
# --- Keychain (Phase 11 hardening, audit fix 2.13) ---
# Master password used to encrypt SaaS OAuth tokens at rest in
# <APP_DATA>/ghita/keychain.json. MUST be at least 16 characters.
# Generate one with: `openssl rand -base64 24`
# SECURITY: never commit a real value. The build refuses to start the
# KeychainStore when this variable is missing or too short.
# ==============================================================================
GHITA_KEYCHAIN_PASSWORD=replace-with-a-strong-random-secret-at-least-16-chars

# ==============================================================================
# --- Sidecar (Phase 11 hardening) ---
# If true, the Tauri shell scans for a free port (preferred +
# 0..31) instead of binding 8080 directly. Defaults to 1.
# ==============================================================================
GHITA_LIBERATE_PORTS=1
